# Copy this file to .env and fill in your own values.
# Never commit .env — it is listed in .gitignore.

# AWS region for Amazon Bedrock
# For ap-south-2 (Hyderabad): use the India cross-region inference profile below.
# For us-east-1: use us.amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1

# Amazon Bedrock model ID
# us-east-1 cross-region profile:  us.amazon.nova-2-lite-v1:0
# ap-south-2 cross-region profile: in.amazon.nova-2-lite-v1:0
SHIP_MODEL=us.amazon.nova-2-lite-v1:0

# Optional: override the judge model used by ss measure (defaults to SHIP_MODEL)
# SHIP_JUDGE_MODEL=us.amazon.nova-2-lite-v1:0

# AWS credentials are NOT stored here.
# Run `aws configure` or `aws sso login` in your own terminal.
